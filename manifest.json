{
  "name": "Right click to call extension",
  "version": "0.2",
  "description": "Simple extension to call a number",
  "manifest_version": 3,
  "icons": {
    "16": "icons8-phone-16.png",
    "32": "icons8-phone-32.png",
    "50": "icons8-phone-50.png",
    "64": "icons8-phone-64.png"
  },
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "main.js"
  }
}